{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "seigou.org"
        }
      ],
      "destination": "https://www.seigou.org/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt" 
    },
    { 
      "source": "/(.*)", 
      "destination": "/" 
    }
  ],
  "env": {
    "VITE_API_BASE_URL": "https://seigou-api.fly.dev",
    "CHROME_PATH": "/usr/bin/chromium"
  },
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "vite"
}
